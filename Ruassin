module test
(
  input clk,
  input rstn,
  input BUT4,
  input BUT3,
  input BUT2,
  input BUT1,

  output [4:0] B,
  output [4:0] G,
  output VGA_HS,
  output [4:0] R,
  output VGA_VS
);

// ================= Pixel clock =================
reg pixel_clk;
always @(posedge clk or negedge rstn) begin
    if (!rstn) pixel_clk <= 1'b0;
    else pixel_clk <= ~pixel_clk;
end

// ================= VGA 640x480 =================
parameter H_VISIBLE = 640;
parameter H_FRONT   = 16;
parameter H_SYNC    = 96;
parameter H_BACK    = 48;
parameter H_TOTAL   = 800;
parameter V_VISIBLE = 480;
parameter V_FRONT   = 10;
parameter V_SYNC    = 2;
parameter V_BACK    = 33;
parameter V_TOTAL   = 525;

reg [9:0] h_cnt;
reg [9:0] v_cnt;

always @(posedge pixel_clk or negedge rstn) begin
    if (!rstn) h_cnt <= 10'd0;
    else if (h_cnt == H_TOTAL - 1) h_cnt <= 10'd0;
    else h_cnt <= h_cnt + 10'd1;
end

always @(posedge pixel_clk or negedge rstn) begin
    if (!rstn) v_cnt <= 10'd0;
    else if (h_cnt == H_TOTAL - 1) begin
        if (v_cnt == V_TOTAL - 1) v_cnt <= 10'd0;
        else v_cnt <= v_cnt + 10'd1;
    end
end

assign VGA_HS = ~((h_cnt >= H_VISIBLE + H_FRONT) &&
                  (h_cnt <  H_VISIBLE + H_FRONT + H_SYNC));
assign VGA_VS = ~((v_cnt >= V_VISIBLE + V_FRONT) &&
                  (v_cnt <  V_VISIBLE + V_FRONT + V_SYNC));

wire active = (h_cnt < H_VISIBLE) && (v_cnt < V_VISIBLE);

// ================= Grid =================
parameter GRID_W = 40;
parameter GRID_H = 30;

wire [5:0] grid_x = h_cnt[9:4];
wire [4:0] grid_y = v_cnt[8:4];
wire grid_line = (h_cnt[3:0] == 4'd0) || (v_cnt[3:0] == 4'd0);

// ================= Game tick =================
reg [23:0] game_cnt;
wire game_tick = (game_cnt == 24'd5_000_000);

always @(posedge clk or negedge rstn) begin
    if (!rstn) game_cnt <= 24'd0;
    else if (game_tick) game_cnt <= 24'd0;
    else game_cnt <= game_cnt + 24'd1;
end

// ================= Key debounce =================
reg [3:0] key_sync0;
reg [3:0] key_sync1;
reg [3:0] key_state;
reg [3:0] key_state_d;
reg [15:0] key_cnt [0:3];
integer ki;

wire [3:0] key_raw = {BUT4, BUT3, BUT2, BUT1};

always @(posedge clk or negedge rstn) begin
    if (!rstn) begin
        key_sync0 <= 4'b0000;
        key_sync1 <= 4'b0000;
        key_state <= 4'b0000;
        key_state_d <= 4'b0000;
        for (ki = 0; ki < 4; ki = ki + 1) key_cnt[ki] <= 16'd0;
    end else begin
        key_sync0 <= key_raw;
        key_sync1 <= key_sync0;
        key_state_d <= key_state;

        for (ki = 0; ki < 4; ki = ki + 1) begin
            if (key_sync1[ki] == key_state[ki]) begin
                key_cnt[ki] <= 16'd0;
            end else if (key_cnt[ki] == 16'hffff) begin
                key_state[ki] <= key_sync1[ki];
                key_cnt[ki] <= 16'd0;
            end else begin
                key_cnt[ki] <= key_cnt[ki] + 16'd1;
            end
        end
    end
end

wire key_rotate_pulse = key_state[0] & ~key_state_d[0]; // BUT1
wire key_down_pulse   = key_state[1] & ~key_state_d[1]; // BUT2
wire key_left_pulse   = key_state[2] & ~key_state_d[2]; // BUT3
wire key_right_pulse  = key_state[3] & ~key_state_d[3]; // BUT4

// ================= Tetris state =================
parameter BOARD_W = 10;
parameter BOARD_H = 20;
parameter BOARD_X0 = 15;
parameter BOARD_Y0 = 5;

localparam PIECE_I = 3'd0;
localparam PIECE_O = 3'd1;
localparam PIECE_T = 3'd2;
localparam PIECE_S = 3'd3;
localparam PIECE_Z = 3'd4;
localparam PIECE_J = 3'd5;
localparam PIECE_L = 3'd6;

reg [BOARD_W-1:0] board [0:BOARD_H-1];
reg [BOARD_W-1:0] temp_board [0:BOARD_H-1];
reg [2:0] piece_type;
reg [1:0] piece_rot;
reg [3:0] piece_x;
reg [4:0] piece_y;
reg [15:0] lfsr;
reg game_over;

integer i;
integer row;
integer col;
integer cx;
integer cy;
integer ax;
integer ay;
integer dst_row;
integer sx;
integer sy;
reg spawn_blocked;

function piece_cell;
    input [2:0] typ;
    input [1:0] rot;
    input integer x;
    input integer y;
    begin
        piece_cell = 1'b0;
        case (typ)
            PIECE_I: begin
                case (rot)
                    2'd0: piece_cell = (y == 1 && x >= 0 && x <= 3);
                    2'd1: piece_cell = (x == 2 && y >= 0 && y <= 3);
                    2'd2: piece_cell = (y == 2 && x >= 0 && x <= 3);
                    2'd3: piece_cell = (x == 1 && y >= 0 && y <= 3);
                endcase
            end
            PIECE_O: begin
                piece_cell = (x >= 1 && x <= 2 && y >= 0 && y <= 1);
            end
            PIECE_T: begin
                case (rot)
                    2'd0: piece_cell = ((x == 1 && y == 0) || (y == 1 && x >= 0 && x <= 2));
                    2'd1: piece_cell = ((x == 1 && y >= 0 && y <= 2) || (x == 2 && y == 1));
                    2'd2: piece_cell = ((y == 1 && x >= 0 && x <= 2) || (x == 1 && y == 2));
                    2'd3: piece_cell = ((x == 1 && y >= 0 && y <= 2) || (x == 0 && y == 1));
                endcase
            end
            PIECE_S: begin
                case (rot)
                    2'd0, 2'd2: piece_cell = ((y == 0 && x >= 1 && x <= 2) || (y == 1 && x >= 0 && x <= 1));
                    2'd1, 2'd3: piece_cell = ((x == 1 && y >= 0 && y <= 1) || (x == 2 && y >= 1 && y <= 2));
                endcase
            end
            PIECE_Z: begin
                case (rot)
                    2'd0, 2'd2: piece_cell = ((y == 0 && x >= 0 && x <= 1) || (y == 1 && x >= 1 && x <= 2));
                    2'd1, 2'd3: piece_cell = ((x == 2 && y >= 0 && y <= 1) || (x == 1 && y >= 1 && y <= 2));
                endcase
            end
            PIECE_J: begin
                case (rot)
                    2'd0: piece_cell = ((x == 0 && y == 0) || (y == 1 && x >= 0 && x <= 2));
                    2'd1: piece_cell = ((x == 1 && y >= 0 && y <= 2) || (x == 2 && y == 0));
                    2'd2: piece_cell = ((y == 1 && x >= 0 && x <= 2) || (x == 2 && y == 2));
                    2'd3: piece_cell = ((x == 1 && y >= 0 && y <= 2) || (x == 0 && y == 2));
                endcase
            end
            PIECE_L: begin
                case (rot)
                    2'd0: piece_cell = ((x == 2 && y == 0) || (y == 1 && x >= 0 && x <= 2));
                    2'd1: piece_cell = ((x == 1 && y >= 0 && y <= 2) || (x == 2 && y == 2));
                    2'd2: piece_cell = ((y == 1 && x >= 0 && x <= 2) || (x == 0 && y == 2));
                    2'd3: piece_cell = ((x == 1 && y >= 0 && y <= 2) || (x == 0 && y == 0));
                endcase
            end
        endcase
    end
endfunction

function [2:0] next_piece;
    input [15:0] rnd;
    begin
        case (rnd[2:0])
            3'd0: next_piece = PIECE_I;
            3'd1: next_piece = PIECE_O;
            3'd2: next_piece = PIECE_T;
            3'd3: next_piece = PIECE_S;
            3'd4: next_piece = PIECE_Z;
            3'd5: next_piece = PIECE_J;
            default: next_piece = PIECE_L;
        endcase
    end
endfunction

function hit_piece;
    input integer nx;
    input integer ny;
    input [2:0] typ;
    input [1:0] rot;
    integer fx;
    integer fy;
    integer bx;
    integer by;
    begin
        hit_piece = 1'b0;
        for (fy = 0; fy < 4; fy = fy + 1) begin
            for (fx = 0; fx < 4; fx = fx + 1) begin
                if (piece_cell(typ, rot, fx, fy)) begin
                    bx = nx + fx;
                    by = ny + fy;
                    if (bx < 0 || bx >= BOARD_W || by < 0 || by >= BOARD_H) begin
                        hit_piece = 1'b1;
                    end else if (board[by][bx]) begin
                        hit_piece = 1'b1;
                    end
                end
            end
        end
    end
endfunction

task reset_game;
    begin
        for (row = 0; row < BOARD_H; row = row + 1) board[row] <= {BOARD_W{1'b0}};
        piece_type <= PIECE_T;
        piece_rot <= 2'd0;
        piece_x <= 4'd3;
        piece_y <= 5'd0;
        lfsr <= 16'hACE1;
        game_over <= 1'b0;
    end
endtask

always @(posedge clk or negedge rstn) begin
    if (!rstn) begin
        reset_game();
    end else begin
        lfsr <= {lfsr[14:0], lfsr[15] ^ lfsr[13] ^ lfsr[12] ^ lfsr[10]};

        if (game_over) begin
            if (key_rotate_pulse || key_down_pulse || key_left_pulse || key_right_pulse) begin
                reset_game();
            end
        end else begin
            if (key_left_pulse && !hit_piece(piece_x - 1, piece_y, piece_type, piece_rot)) begin
                piece_x <= piece_x - 4'd1;
            end else if (key_right_pulse && !hit_piece(piece_x + 1, piece_y, piece_type, piece_rot)) begin
                piece_x <= piece_x + 4'd1;
            end

            if (key_rotate_pulse && !hit_piece(piece_x, piece_y, piece_type, piece_rot + 2'd1)) begin
                piece_rot <= piece_rot + 2'd1;
            end

            if (key_down_pulse && !hit_piece(piece_x, piece_y + 1, piece_type, piece_rot)) begin
                piece_y <= piece_y + 5'd1;
            end

            if (game_tick) begin
                if (!hit_piece(piece_x, piece_y + 1, piece_type, piece_rot)) begin
                    piece_y <= piece_y + 5'd1;
                end else begin
                    for (row = 0; row < BOARD_H; row = row + 1) begin
                        temp_board[row] = board[row];
                    end

                    for (cy = 0; cy < 4; cy = cy + 1) begin
                        for (cx = 0; cx < 4; cx = cx + 1) begin
                            if (piece_cell(piece_type, piece_rot, cx, cy)) begin
                                ax = piece_x + cx;
                                ay = piece_y + cy;
                                if (ax >= 0 && ax < BOARD_W && ay >= 0 && ay < BOARD_H) begin
                                    temp_board[ay][ax] = 1'b1;
                                end
                            end
                        end
                    end

                    dst_row = BOARD_H - 1;
                    for (row = BOARD_H - 1; row >= 0; row = row - 1) begin
                        if (temp_board[row] != {BOARD_W{1'b1}}) begin
                            temp_board[dst_row] = temp_board[row];
                            dst_row = dst_row - 1;
                        end
                    end
                    for (row = 0; row < BOARD_H; row = row + 1) begin
                        if (row <= dst_row) begin
                            temp_board[row] = {BOARD_W{1'b0}};
                        end
                    end

                    for (row = 0; row < BOARD_H; row = row + 1) begin
                        board[row] <= temp_board[row];
                    end

                    spawn_blocked = 1'b0;
                    for (cy = 0; cy < 4; cy = cy + 1) begin
                        for (cx = 0; cx < 4; cx = cx + 1) begin
                            if (piece_cell(next_piece(lfsr), 2'd0, cx, cy)) begin
                                sx = 3 + cx;
                                sy = cy;
                                if (temp_board[sy][sx]) begin
                                    spawn_blocked = 1'b1;
                                end
                            end
                        end
                    end

                    piece_type <= next_piece(lfsr);
                    piece_rot <= 2'd0;
                    piece_x <= 4'd3;
                    piece_y <= 5'd0;
                    if (spawn_blocked) begin
                        game_over <= 1'b1;
                    end
                end
            end
        end
    end
end

// ================= Pixel test =================
wire in_board = (grid_x >= BOARD_X0) && (grid_x < BOARD_X0 + BOARD_W) &&
                (grid_y >= BOARD_Y0) && (grid_y < BOARD_Y0 + BOARD_H);
wire [3:0] board_x = grid_x - BOARD_X0;
wire [4:0] board_y = grid_y - BOARD_Y0;

reg is_fixed;
reg is_piece;

always @(*) begin
    is_fixed = 1'b0;
    is_piece = 1'b0;

    if (in_board) begin
        is_fixed = board[board_y][board_x];
    end

    for (cy = 0; cy < 4; cy = cy + 1) begin
        for (cx = 0; cx < 4; cx = cx + 1) begin
            if (piece_cell(piece_type, piece_rot, cx, cy)) begin
                if (in_board &&
                    board_x == piece_x + cx &&
                    board_y == piece_y + cy) begin
                    is_piece = 1'b1;
                end
            end
        end
    end
end

// ================= Color =================
reg [4:0] r;
reg [4:0] g;
reg [4:0] b;

always @(*) begin
    if (!active) begin
        r = 5'd0;
        g = 5'd0;
        b = 5'd0;
    end else if (game_over) begin
        if (in_board && (is_fixed || is_piece)) begin
            r = 5'd31;
            g = 5'd5;
            b = 5'd5;
        end else if (in_board) begin
            r = 5'd8;
            g = 5'd0;
            b = 5'd0;
        end else begin
            r = 5'd0;
            g = 5'd0;
            b = 5'd0;
        end
    end else if (is_piece) begin
        case (piece_type)
            PIECE_I: begin r = 5'd0;  g = 5'd28; b = 5'd31; end
            PIECE_O: begin r = 5'd31; g = 5'd28; b = 5'd0;  end
            PIECE_T: begin r = 5'd22; g = 5'd0;  b = 5'd31; end
            PIECE_S: begin r = 5'd0;  g = 5'd31; b = 5'd8;  end
            PIECE_Z: begin r = 5'd31; g = 5'd0;  b = 5'd5;  end
            PIECE_J: begin r = 5'd0;  g = 5'd8;  b = 5'd31; end
            default: begin r = 5'd31; g = 5'd14; b = 5'd0;  end
        endcase
    end else if (is_fixed) begin
        r = 5'd18;
        g = 5'd18;
        b = 5'd20;
    end else if (in_board && grid_line) begin
        r = 5'd4;
        g = 5'd4;
        b = 5'd5;
    end else if (in_board) begin
        r = 5'd1;
        g = 5'd1;
        b = 5'd2;
    end else begin
        r = 5'd0;
        g = 5'd0;
        b = 5'd0;
    end
end

assign R = r;
assign G = g;
assign B = b;

endmodule
